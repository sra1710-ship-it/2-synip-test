<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2-сыныпқа арналған интерактивті тапсырма</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; }
        .container { max-width: 600px; background: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); margin: auto; }
        h2 { text-align: center; color: #333; }
        .form-group { margin-bottom: 20px; }
        label { display: block; font-weight: bold; margin-bottom: 8px; color: #444; }
        input[type="text"] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; }
        .question { margin-bottom: 20px; padding: 15px; background: #f9f9f9; border-radius: 5px; border-left: 4px solid #4CAF50; }
        .question p { font-weight: bold; margin-top: 0; }
        .options label { font-weight: normal; display: block; margin-bottom: 5px; cursor: pointer; }
        button { display: block; width: 100%; background-color: #4CAF50; color: white; padding: 12px; border: none; border-radius: 5px; font-size: 16px; cursor: pointer; }
        button:hover { background-color: #45a049; }
        #result { text-align: center; font-size: 18px; font-weight: bold; margin-top: 20px; color: #333; }
    </style>
</head>
<body>

<div class="container" id="quiz-container">
    <h2>2-сынып: Қорытынды тапсырма (10 балл)</h2>
    
    <div class="form-group">
        <label for="studentName">Оқушының Аты-Жөні:</label>
        <input type="text" id="studentName" placeholder="Мысалы: Асанұлы Ернар" required>
    </div>

    <form id="quizForm">
        <!-- 1 сұрақ -->
        <div class="question">
            <p>1. Сыныпта 15 ұл бала және 12 қыз бала бар. Барлығы қанша оқушы?</p>
            <div class="options">
                <label><input type="radio" name="q1" value="0"> А) 25</label>
                <label><input type="radio" name="q1" value="1"> Б) 27</label>
                <label><input type="radio" name="q1" value="0"> В) 30</label>
            </div>
        </div>

        <!-- 2 сұрақ -->
        <div class="question">
            <p>2. «Кітап» сөзінде неше әріп, неше дыбыс бар?</p>
            <div class="options">
                <label><input type="radio" name="q2" value="1"> А) 5 әріп, 5 дыбыс</label>
                <label><input type="radio" name="q2" value="0"> Б) 4 әріп, 5 дыбыс</label>
                <label><input type="radio" name="q2" value="0"> В) 6 әріп, 6 дыбыс</label>
            </div>
        </div>

        <!-- 3 сұрақ -->
        <div class="question">
            <p>3. Өрнектің мәнін тап: 45 + (18 - 10) = ?</p>
            <div class="options">
                <label><input type="radio" name="q3" value="1"> А) 53</label>
                <label><input type="radio" name="q3" value="0"> Б) 43</label>
                <label><input type="radio" name="q3" value="0"> В) 55</label>
            </div>
        </div>

        <!-- 4 сұрақ -->
        <div class="question">
            <p>4. Қай сөз қатесіз жазылған?</p>
            <div class="options">
                <label><input type="radio" name="q4" value="1"> А) Мектеп</label>
                <label><input type="radio" name="q4" value="0"> Б) Мектеб</label>
                <label><input type="radio" name="q4" value="0"> В) Мектепь</label>
            </div>
        </div>

        <!-- 5 сұрақ -->
        <div class="question">
            <p>5. Сандар қатарындағы келесі санды тап: 5, 10, 15, 20, ...</p>
            <div class="options">
                <label><input type="radio" name="q5" value="0"> А) 22</label>
                <label><input type="radio" name="q5" value="1"> Б) 25</label>
                <label><input type="radio" name="q5" value="0"> В) 30</label>
            </div>
        </div>

        <!-- 6 сұрақ -->
        <div class="question">
            <p>6. Сөйлемнің соңына қандай тыныс белгісі қойылады? (Айсұлу мектепке бара жатыр)</p>
            <div class="options">
                <label><input type="radio" name="q6" value="0"> А) Сұрақ белгісі (?)</label>
                <label><input type="radio" name="q6" value="1"> Б) Нүкте (.)</label>
                <label><input type="radio" name="q6" value="0"> В) Леп белгісі (!)</label>
            </div>
        </div>

        <!-- 7 сұрақ -->
        <div class="question">
            <p>7. Тіктөртбұрыштың қабырғалары нешеу?</p>
            <div class="options">
                <label><input type="radio" name="q7" value="0"> А) 3</label>
                <label><input type="radio" name="q7" value="1"> Б) 4</label>
                <label><input type="radio" name="q7" value="0"> В) 5</label>
            </div>
        </div>

        <!-- 8 сұрақ -->
        <div class="question">
            <p>8. Заттың атын білдіретін сөзді тап:</p>
            <div class="options">
                <label><input type="radio" name="q8" value="0"> А) Жүгірді</label>
                <label><input type="radio" name="q8" value="0"> Б) Қызыл</label>
                <label><input type="radio" name="q8" value="1"> В) Алма</label>
            </div>
        </div>

        <!-- 9 сұрақ -->
        <div class="question">
            <p>9. 1 сағатта неше минут бар?</p>
            <div class="options">
                <label><input type="radio" name="q9" value="0"> А) 30 минут</label>
                <label><input type="radio" name="q9" value="1"> Б) 60 минут</label>
                <label><input type="radio" name="q9" value="0"> В) 100 минут</label>
            </div>
        </div>

        <!-- 10 сұрақ -->
        <div class="question">
            <p>10. Қай сөз дыбыс пен әріп саны бірдей сөздер қатарына жатады?</p>
            <div class="options">
                <label><input type="radio" name="q10" value="0"> А) Ағаш</label>
                <label><input type="radio" name="q10" value="1"> Б) Дала</label>
                <label><input type="radio" name="q10" value="0"> В) Қой</label>
            </div>
        </div>

        <button type="button" onclick="submitQuiz()">Тапсырманы аяқтау және жіберу</button>
    </form>
    
    <div id="result"></div>
</div>

<script>
function submitQuiz() {
    const name = document.getElementById('studentName').value.trim();
    if (!name) {
        alert('Өтінемін, оқушының аты-жөнін жазыңыз!');
        return;
    }

    let score = 0;
    for (let i = 1; i <= 10; i++) {
        const radios = document.getElementsByName('q' + i);
        let answered = false;
        for (let r of radios) {
            if (r.checked) {
                answered = true;
                score += parseInt(r.value);
            }
        }
    }

    // Google Script сілтемесін мына жерге қоясыз:
    const scriptURL = 'ЖЕРГЕ_GOOGLE_SCRIPT_СІЛТЕМЕСІН_ЖАЗЫҢЫЗ';

    if (scriptURL === 'ЖЕРГЕ_GOOGLE_SCRIPT_СІЛТЕМЕСІН_ЖАЗЫҢЫЗ') {
        document.getElementById('result').innerHTML = `Нәтижеңіз: ${score} балл. (Ескерту: Google кесте сілтемесі орнатылмаған!)`;
        return;
    }

    const data = { name: name, score: score };

    fetch(scriptURL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    }).then(() => {
        document.getElementById('quizForm').style.display = 'none';
        document.getElementById('result').innerHTML = `Рахмет, ${name}! Сіздің жинаған балыңыз: ${score} / 10. Нәтиже мұғалімнің кестесіне сәтті сақталды!`;
    }).catch(error => {
        alert('Қате орын алды. Қайта көріңіз.');
    });
}
</script>

</body>
</html>
